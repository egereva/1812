# Client-side Yandex Maps key; visible in the browser. Restrict allowed domains in Yandex settings.
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Example for a GitHub project page: /repository-name/
NUXT_APP_BASE_URL=/

# Real HTTPS production origin only (no path); leave empty until Stage 10.
# Absolute canonical/hreflang/og:url and sitemap are omitted when empty.
NUXT_PUBLIC_SITE_URL=
