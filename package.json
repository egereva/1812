{
  "name": "interactive-1812-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "format": "prettier --write app shared content/ru content/en test i18n nuxt.config.ts eslint.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check app shared content/ru content/en test i18n nuxt.config.ts eslint.config.mjs tsconfig.json package.json",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none test/content.test.ts test/hero.test.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "nuxt": "^4.5.2",
    "swiper": "^12.2.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "packageManager": "npm@10.9.9"
}
