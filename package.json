{
  "name": "interactive-1812-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "media:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-image-delivery.ps1 && prettier --write app/data/imageDelivery.json",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "format": "prettier --write app shared content/ru content/en test i18n nuxt.config.ts eslint.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check app shared content/ru content/en test i18n nuxt.config.ts eslint.config.mjs tsconfig.json package.json",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none test/content.test.ts test/hero.test.ts test/map.test.ts test/links.test.ts test/image-delivery.test.ts test/homepage-map.test.mjs",
    "test:homepage-render": "node --test --experimental-test-isolation=none test/homepage-render.test.mjs",
    "test:links-render": "node --test --experimental-test-isolation=none test/links-render.test.mjs",
    "test:places-detail-render": "node --experimental-strip-types --test --experimental-test-isolation=none test/places-detail-render.test.mjs",
    "test:timeline-detail-render": "node --test --experimental-test-isolation=none test/timeline-detail-render.test.mjs",
    "test:map-index-render": "node --experimental-strip-types --test --experimental-test-isolation=none test/map-index-render.test.mjs",
    "test:dictionary-places-render": "node --experimental-strip-types --test --experimental-test-isolation=none test/dictionary-places-render.test.mjs",
    "test:stage8-navigation": "node --experimental-strip-types --test --experimental-test-isolation=none test/stage8-navigation-render.test.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.2.1",
    "nuxt": "^4.5.2",
    "photoswipe": "5.4.4",
    "swiper": "^12.2.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "packageManager": "npm@10.9.9"
}
